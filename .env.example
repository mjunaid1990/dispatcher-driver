# Dispatcher Driver App - API Configuration
# Copy this file to `.env` and fill in your server URL.
# This is the Node.js API server (dispatcher-server). Include the /api suffix.
# After changing .env, restart `npm start` (Expo) for it to take effect.

EXPO_PUBLIC_API_URL=https://dispatcher-server-production.up.railway.app/api

# Request timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT=30000

# Currency configuration (3-letter ISO code + symbol). Defaults: USD / $
EXPO_PUBLIC_CURRENCY_CODE=USD
EXPO_PUBLIC_CURRENCY_SYMBOL=$

# Base delivery fee per package size. Defaults: 5 / 8 / 12
EXPO_PUBLIC_BASE_FEE_SMALL=5
EXPO_PUBLIC_BASE_FEE_MEDIUM=8
EXPO_PUBLIC_BASE_FEE_LARGE=12

# ── Local development options (uncomment ONE) ──
# Android emulator (host machine is 10.0.2.2):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
# iOS simulator / web:
# EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Physical device via Expo Go (use your computer's LAN IP, e.g. from ipconfig):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api
